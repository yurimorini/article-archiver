{
    "name": "yumo/log-read",
    "description": "Log reading library",
    "type": "library",
    "license": "MIT",
    "require": {
      "php": "^8.3",
        "fivefilters/readability.php": "^4.0",
        "guzzlehttp/guzzle": "^8.0",
        "ezyang/htmlpurifier": "^4.19",
        "fossar/guzzle-transcoder": "^0.3.2"
    },
    "require-dev": {
      "phpunit/phpunit": "^11.0"
    },
    "autoload": {
      "psr-4": {
        "Yumo\\LogRead\\": "src/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Yumo\\LogRead\\Tests\\": "tests/"
      }
    },
    "scripts": {
      "test": "phpunit"
    }
  }
