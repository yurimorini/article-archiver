{
    "name": "yumo/log-read",
    "description": "Log reading library",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "fivefilters/readability.php": "^4.0",
        "guzzlehttp/guzzle": "^8.0",
        "ezyang/htmlpurifier": "^4.19",
        "fossar/guzzle-transcoder": "^0.3.2",
        "craftcms/url-validator": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Yumo\\LogRead\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yumo\\LogRead\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "quality": [
            "@cs-check",
            "@phpstan"
        ]
    }
}
