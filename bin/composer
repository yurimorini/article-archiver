#!/usr/bin/env bash
# Run Composer in one package. The package name is required; this command is not fanned out.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/projects.sh
source "${ROOT_DIR}/bin/lib/projects.sh"

if [[ $# -lt 1 ]]; then
  printf 'Usage: ./bin/composer <package> [composer-args...]\n' >&2
  projects_names "${ROOT_DIR}/bin/projects" >&2
  exit 1
fi

package_name="$1"
shift

if ! package_rel="$(projects_path_for "${ROOT_DIR}/bin/projects" "${package_name}")"; then
  printf 'Unknown package: %s\n' "${package_name}" >&2
  projects_names "${ROOT_DIR}/bin/projects" >&2
  exit 1
fi

exec "${ROOT_DIR}/bin/docker-run" "${package_name}" composer --working-dir="/workspace/${package_rel}" "$@"
