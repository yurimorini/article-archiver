#!/usr/bin/env bash
# Run a command inside the shared PHP image, with the working directory set to one package.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/projects.sh
source "${ROOT_DIR}/bin/lib/projects.sh"
# shellcheck source=lib/container.sh
source "${ROOT_DIR}/bin/lib/container.sh"

IMAGE_NAME="${IMAGE_NAME:-log-read-php}"

if [[ $# -lt 2 ]]; then
  printf 'Usage: ./bin/docker-run <package> <command> [args...]\n' >&2
  exit 1
fi

package_name="$1"
shift

if ! package_rel="$(projects_path_for "${ROOT_DIR}/bin/projects" "${package_name}")"; then
  printf 'Unknown package: %s\n' "${package_name}" >&2
  projects_names "${ROOT_DIR}/bin/projects" >&2
  exit 1
fi

if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
  printf "Docker image '%s' not found. Build it with: ./bin/docker-build\n" "${IMAGE_NAME}" >&2
  exit 1
fi

container_fill_run_args "${ROOT_DIR}" "${package_rel}"

exec docker run "${run_args[@]}" "${IMAGE_NAME}" "$@"
