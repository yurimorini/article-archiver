#!/usr/bin/env bash
# Run a command inside the shared PHP image, with the working directory set to one package.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/container.sh
source "${ROOT_DIR}/bin/lib/container.sh"

IMAGE_NAME="${IMAGE_NAME:-log-read-php}"

if [[ $# -lt 2 ]]; then
  printf 'Usage: ./bin/docker-run <path> <command> [args...]\n' >&2
  exit 1
fi

package_rel="$1"
shift

root_real="$(cd "${ROOT_DIR}" && pwd -P)"
package_abs="$(realpath -m -- "${ROOT_DIR}/${package_rel}")"
case "${package_abs}" in
  "${root_real}"/*) ;;
  *)
    printf 'Package path must stay inside the repository: %s\n' "${package_rel}" >&2
    exit 1
    ;;
esac

if [[ ! -d "${package_abs}" ]]; then
  printf 'Package path not found: %s\n' "${package_rel}" >&2
  exit 1
fi

package_rel="${package_abs#"${root_real}/"}"

container_require_image "${IMAGE_NAME}"
container_fill_run_args "${ROOT_DIR}" "${package_rel}"

exec docker run "${run_args[@]}" "${IMAGE_NAME}" "$@"
