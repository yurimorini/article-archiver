#!/usr/bin/env bash
# Run a command inside the shared PHP image, with the working directory set to one package.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/projects.sh
source "${ROOT_DIR}/bin/lib/projects.sh"

IMAGE_NAME="${IMAGE_NAME:-log-read-php}"

if [[ $# -lt 2 ]]; then
  printf 'Usage: ./bin/docker-run <package> <command> [args...]\n' >&2
  exit 1
fi

package_name="$1"
shift

if ! package_rel="$(projects_path_for "${ROOT_DIR}/bin/projects" "${package_name}")"; then
  printf 'Unknown package: %s\n' "${package_name}" >&2
  projects_names "${ROOT_DIR}/bin/projects" >&2
  exit 1
fi

if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
  printf "Docker image '%s' not found. Build it with: ./bin/docker-build\n" "${IMAGE_NAME}" >&2
  exit 1
fi

security_options="$(docker info --format '{{json .SecurityOptions}}')"
run_args=(
  --rm
  -v "${ROOT_DIR}:/workspace"
  -w "/workspace/${package_rel}"
  -e "COMPOSER_HOME=/workspace/${package_rel}/.composer"
  -e HOME=/workspace
)

if [[ "${security_options}" == *'"name=rootless"'* ]]; then
  # Container uid 0 is the host user. The host uid is a different user inside
  # the namespace, so Git rejects /workspace and Composer cannot write vendor/.
  # Slirp also blocks host loopback, so Xdebug cannot reach an IDE on
  # 127.0.0.1:9003. Stay off unless the caller sets XDEBUG_MODE.
  run_args+=(-e COMPOSER_ALLOW_SUPERUSER=1)
  if [[ -n "${XDEBUG_MODE+x}" ]]; then
    run_args+=(-e "XDEBUG_MODE=${XDEBUG_MODE}")
    if [[ "${XDEBUG_MODE}" != "off" ]]; then
      run_args+=(-e "XDEBUG_CONFIG=${XDEBUG_CONFIG:-client_host=10.0.2.2}")
    fi
  else
    run_args+=(-e XDEBUG_MODE=off)
  fi
else
  run_args+=(
    --user "$(id -u):$(id -g)"
    --add-host=host.docker.internal:host-gateway
  )
fi

exec docker run "${run_args[@]}" "${IMAGE_NAME}" "$@"
