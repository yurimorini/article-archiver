#!/usr/bin/env bash
# Run a command inside the project PHP Docker image with the repo mounted.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE_NAME="${IMAGE_NAME:-log-read-php}"

if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
  echo "Docker image '${IMAGE_NAME}' not found. Build it with: ./bin/docker-build" >&2
  exit 1
fi

exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  -v "${ROOT_DIR}:/workspace" \
  -w /workspace \
  -e COMPOSER_HOME=/workspace/.composer \
  -e HOME=/workspace \
  "${IMAGE_NAME}" \
  "$@"
